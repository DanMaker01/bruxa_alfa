[gd_resource type="Resource" script_class="CatalogoPocoes" format=3]

[ext_resource type="Script" path="res://src/dados/catalogo_pocoes.gd" id="1_cat"]
[ext_resource type="Script" path="res://src/dados/pocao_referencia.gd" id="2_ref"]

[sub_resource type="Resource" id="Resource_calma"]
script = ExtResource("2_ref")
nome = "Poção da Calma Profunda"
descricao = "Acalma os nervos sem mudar quem a pessoa é."
A = Array[PackedFloat32Array]([PackedFloat32Array(1, 0, 0, 0, 0), PackedFloat32Array(0, 1, 0, 0, 0), PackedFloat32Array(0, 0, 1, 0, 0), PackedFloat32Array(0, 0, 0, 1, 0), PackedFloat32Array(0, 0, 0, 0, 0.5625)])

[sub_resource type="Resource" id="Resource_labia"]
script = ExtResource("2_ref")
nome = "Poção da Desenvoltura"
descricao = "Solta a língua e a timidez, e a pessoa continua sendo ela mesma."
A = Array[PackedFloat32Array]([PackedFloat32Array(1, 0, 0, 0, 0), PackedFloat32Array(0, 1, 0, 0, 0), PackedFloat32Array(0, 0, 1.2, 0, 0), PackedFloat32Array(0, 0, 0, 1, 0), PackedFloat32Array(0, 0, -0.01, 0, 1)])

[sub_resource type="Resource" id="Resource_identidade"]
script = ExtResource("2_ref")
nome = "Água de Caldeirão"
descricao = "Não muda nada em quem bebe. Pelo menos não faz mal."
A = Array[PackedFloat32Array]([PackedFloat32Array(1, 0, 0, 0, 0), PackedFloat32Array(0, 1, 0, 0, 0), PackedFloat32Array(0, 0, 1, 0, 0), PackedFloat32Array(0, 0, 0, 1, 0), PackedFloat32Array(0, 0, 0, 0, 1)])

[resource]
script = ExtResource("1_cat")
distancia_max = 0.05
pocoes = Array[ExtResource("2_ref")]([SubResource("Resource_calma"), SubResource("Resource_labia"), SubResource("Resource_identidade")])
