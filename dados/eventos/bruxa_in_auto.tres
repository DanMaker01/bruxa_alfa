[sub_resource type="Resource" id="Resource_m45oa"]
script = ExtResource("4_xme6w")
segundos = 4.5

[sub_resource type="Resource" id="Resource_3bqtm"]
script = ExtResource("6_kgd5i")
personagem = ExtResource("x3")
posicao = 100.0
texto = "Com licença..."

[sub_resource type="Resource" id="Resource_dxax8"]
script = ExtResource("6_kgd5i")
personagem = ExtResource("x3")
posicao = 100.0
texto = "É aqui que mora a Bruxa? Passei o dia todo andando, quase me perdi duas vezes."

[sub_resource type="Resource" id="Resource_aj5ti"]
script = ExtResource("6_kgd5i")
personagem = ExtResource("x3")
posicao = 100.0
texto = "Eu queria falar com você, porque minh..."

[sub_resource type="Resource" id="R_irma_brux_0"]
script = ExtResource("6_kgd5i")
personagem = ExtResource("x3")
posicao = 100.0
texto = "A princesa vai se casar amanhã. Mas ela não sai da cama."

[sub_resource type="Resource" id="R_irma_brux_1"]
script = ExtResource("6_kgd5i")
personagem = ExtResource("x3")
posicao = 100.0
texto = "Eu trabalho no castelo. Cuido dos cavalos."

[sub_resource type="Resource" id="R_irma_brux_2"]
script = ExtResource("6_kgd5i")
personagem = ExtResource("x1")
texto = "Certo. E o que ela tem?"

[sub_resource type="Resource" id="Resource_cjxqi"]
script = ExtResource("6_kgd5i")
personagem = ExtResource("x3")
posicao = 100.0
texto = "Ela fala que o coração dispara, as mãos tremem, ela não come, não dorme."

[sub_resource type="Resource" id="Resource_uh1o3"]
script = ExtResource("6_kgd5i")
personagem = ExtResource("x3")
posicao = 100.0
texto = "Fica dizendo que vai estragar tudo, que o noivo vai desistir, que todo mundo vai rir dela."

[sub_resource type="Resource" id="Resource_knokq"]
script = ExtResource("6_kgd5i")
personagem = ExtResource("x3")
posicao = 100.0
texto = "Já chamaram os curandeiros do castelo, mas ela não melhora."

[sub_resource type="Resource" id="T_cura2"]
script = ExtResource("6_kgd5i")
personagem = ExtResource("x3")
posicao = 100.0
texto = "Talvez o casamento nem aconteça. Ninguém sabe mais o que fazer."

[sub_resource type="Resource" id="R_estilo_pensa"]
script = ExtResource("92_chamar")
evento = ExtResource("93_pensa_ini")

[sub_resource type="Resource" id="Resource_67ysa"]
script = ExtResource("6_kgd5i")
personagem = ExtResource("x1")
face = "pensando"
texto = "Coração disparado. Mãos trêmulas. A cabeça só pensa no pior."

[sub_resource type="Resource" id="Resource_rbw8v"]
script = ExtResource("6_kgd5i")
personagem = ExtResource("x1")
face = "pensando"
texto = "Parece que o corpo dela não sabe mais descansar."

[sub_resource type="Resource" id="R_estilo_volta"]
script = ExtResource("92_chamar")
evento = ExtResource("94_pensa_fim")

[sub_resource type="Resource" id="Resource_s0kd1"]
script = ExtResource("6_kgd5i")
personagem = ExtResource("x1")
texto = "Eu acho que uma Poção da Calma Profunda deve resolver."

[sub_resource type="Resource" id="Resource_rgmyk"]
script = ExtResource("6_kgd5i")
personagem = ExtResource("x3")
posicao = 100.0
texto = "Calma profunda?"

[sub_resource type="Resource" id="Resource_7fgmm"]
script = ExtResource("6_kgd5i")
personagem = ExtResource("x1")
texto = "O medo vai continuar ali. Mas ela vai conseguir agir apesar dele. Levantar da cama, vestir o vestido, atravessar a igreja."

[sub_resource type="Resource" id="Resource_3fdd6"]
script = ExtResource("6_kgd5i")
personagem = ExtResource("x1")
texto = "Deixe eu me lembrar... "

[sub_resource type="Resource" id="Resource_c04db"]
script = ExtResource("6_kgd5i")
personagem = ExtResource("x1")
texto = "São oito ervas, que posso pegar no final da floresta."
metadata/_custom_type_script = "uid://8liac65hmnnq"

[sub_resource type="Resource" id="Resource_1dger"]
script = ExtResource("6_kgd5i")
personagem = ExtResource("x3")
posicao = 100.0
texto = "No fim da floresta? Eu tenho medo de ir lá, desde que o príncipe Zigmund sumiu..."

[sub_resource type="Resource" id="Resource_3cm0n"]
script = ExtResource("6_kgd5i")
personagem = ExtResource("x1")
texto = "Entendo... Deixa essa parte comigo."

[sub_resource type="Resource" id="Resource_ajdrk"]
script = ExtResource("6_kgd5i")
personagem = ExtResource("x1")
texto = "E quatro cogumelos, que crescem logo depois da cidade."

[sub_resource type="Resource" id="Resource_e4tah"]
script = ExtResource("6_kgd5i")
personagem = ExtResource("x1")
texto = "Vá para casa. Amanhã, antes do casamento, ela vai estar mais tranquila."

[sub_resource type="Resource" id="Resource_4ohjl"]
script = ExtResource("6_kgd5i")
personagem = ExtResource("x3")
posicao = 100.0
texto = "A senhora... vai mesmo me ajudar?"

[sub_resource type="Resource" id="Resource_lym1c"]
script = ExtResource("6_kgd5i")
personagem = ExtResource("x1")
texto = "Ajudar não! Tudo tem seu preço."

[sub_resource type="Resource" id="Resource_5iktt"]
script = ExtResource("6_kgd5i")
personagem = ExtResource("x1")
texto = "Não será barato, mas eu só cobro o preço justo. Nem a mais, nem a menos."

[sub_resource type="Resource" id="Resource_l8py2"]
script = ExtResource("6_kgd5i")
personagem = ExtResource("x3")
posicao = 100.0
texto = "Está bem. Obrigado. Obrigado mesmo."

[sub_resource type="Resource" id="Resource_avisoguarda"]
script = ExtResource("6_kgd5i")
personagem = ExtResource("x3")
posicao = 100.0
texto = "Ah! O rei já avisou os guardas sobre você. Mas só vão te deixar passar se tiver a poção em mãos."

[sub_resource type="Resource" id="Resource_optqh"]
script = ExtResource("6_kgd5i")
personagem = ExtResource("x3")
posicao = 100.0
texto = "Adeus, senhora bruxa!"
metadata/_custom_type_script = "uid://8liac65hmnnq"

