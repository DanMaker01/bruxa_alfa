[sub_resource type="Resource" id="Resource_j0oay"]
script = ExtResource("8_fxvs5")
tempo = 4.0

[sub_resource type="Resource" id="Resource_m45oa"]
script = ExtResource("4_xme6w")
segundos = 4.5

[sub_resource type="Resource" id="Resource_3bqtm"]
script = ExtResource("6_kgd5i")
texto = "[CAMPONÊS;campones;100] Com licença..."

[sub_resource type="Resource" id="Resource_dxax8"]
script = ExtResource("6_kgd5i")
texto = "[CAMPONÊS;campones;100] É aqui que mora a Bruxa? Passei o dia todo andando, quase me perdi duas vezes."

[sub_resource type="Resource" id="Resource_aj5ti"]
script = ExtResource("6_kgd5i")
texto = "[CAMPONÊS;campones;100] Eu queria falar com você, porque minha irmã vai se casar amanhã. Mas ela não sai da cama."

[sub_resource type="Resource" id="Resource_cjxqi"]
script = ExtResource("6_kgd5i")
texto = "[CAMPONÊS;campones;100] Ela fala que o coração dispara, as mãos tremem, ela não come, não dorme."

[sub_resource type="Resource" id="Resource_uh1o3"]
script = ExtResource("6_kgd5i")
texto = "[CAMPONÊS;campones;100] Fica dizendo que vai estragar tudo, que o noivo vai desistir, que todo mundo vai rir dela."

[sub_resource type="Resource" id="Resource_knokq"]
script = ExtResource("6_kgd5i")
texto = "[CAMPONÊS;campones;100] Já chamei um médico, mas ela não melhora, e talvez o casamento não aconteça. Eu não sei mais o que fazer."

[sub_resource type="Resource" id="Resource_67ysa"]
script = ExtResource("6_kgd5i")
texto = "[BRUXA;bruxa_grande;0] (pensando) Coração disparado. Mãos trêmulas. Pensamentos catastróficos. "

[sub_resource type="Resource" id="Resource_rbw8v"]
script = ExtResource("6_kgd5i")
texto = "[BRUXA;bruxa_grande;0] (pensando) Parece que alguém tem um alarme que não desliga."

[sub_resource type="Resource" id="Resource_s0kd1"]
script = ExtResource("6_kgd5i")
texto = "[BRUXA;bruxa_grande;0] Entendi. Ela precisa de uma Poção da Calma Lúcida."

[sub_resource type="Resource" id="Resource_rgmyk"]
script = ExtResource("6_kgd5i")
texto = "[CAMPONÊS;campones;100] Calma lúcida?"

[sub_resource type="Resource" id="Resource_7fgmm"]
script = ExtResource("6_kgd5i")
texto = "[BRUXA;bruxa_grande;0] O medo vai continuar ali. Mas ela vai conseguir agir apesar dele. Levantar da cama, vestir o vestido, atravessar a igreja."

[sub_resource type="Resource" id="Resource_3fdd6"]
script = ExtResource("6_kgd5i")
texto = "[BRUXA;bruxa_grande;0] Para essa poção são só dois ingredientes. Um cogumelo que cresce onde a floresta acaba. "

[sub_resource type="Resource" id="Resource_ajdrk"]
script = ExtResource("6_kgd5i")
texto = "[BRUXA;bruxa_grande;0] E uma folha que posso , onde as árvores acabam."

[sub_resource type="Resource" id="Resource_1dger"]
script = ExtResource("6_kgd5i")
texto = "[CAMPONÊS;campones;100] No fim da floresta? Dá um medo de ir lá."

[sub_resource type="Resource" id="Resource_3cm0n"]
script = ExtResource("6_kgd5i")
texto = "[BRUXA;bruxa_grande;0] Eu sei. Deixa essa parte comigo."

[sub_resource type="Resource" id="Resource_e4tah"]
script = ExtResource("6_kgd5i")
texto = "[BRUXA;bruxa_grande;0] Vá para casa. Fique com sua irmã. Amanhã, antes do casamento, ela vai estar de pé."

[sub_resource type="Resource" id="Resource_4ohjl"]
script = ExtResource("6_kgd5i")
texto = "[CAMPONÊS;campones;100] A senhora... vai mesmo me ajudar?"

[sub_resource type="Resource" id="Resource_lym1c"]
script = ExtResource("6_kgd5i")
texto = "[BRUXA;bruxa_grande;0] Ajudar não! Tudo tem seu preço."

[sub_resource type="Resource" id="Resource_5iktt"]
script = ExtResource("6_kgd5i")
texto = "[BRUXA;bruxa_grande;0] E não será barato."

[sub_resource type="Resource" id="Resource_l8py2"]
script = ExtResource("6_kgd5i")
texto = "[CAMPONÊS;campones;100] Tudo bem. Obrigado. Obrigado mesmo."

