[sub_resource type="Resource" id="Resource_aqp7k"]
script = ExtResource("6_kgd5i")
texto = "[BRUXA;bruxa_grande;0] Você não seria da inquisição, não é?"

[sub_resource type="Resource" id="Resource_rj6aj"]
script = ExtResource("6_kgd5i")
texto = "[???;;100] Não, não. Sou só um camponês."

[sub_resource type="Resource" id="Resource_lili8"]
script = ExtResource("6_kgd5i")
texto = "[BRUXA;bruxa_grande;0] (desconfiada) Pode entrar..."

[sub_resource type="Resource" id="Resource_3g0ce"]
