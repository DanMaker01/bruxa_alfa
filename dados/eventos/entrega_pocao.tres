[sub_resource type="Resource" id="R_109"]
script = ExtResource("4_x")
texto = "[PRINCESA;princesa;100] Eu... já me sinto mais calma."

[sub_resource type="Resource" id="R_110"]
script = ExtResource("2_x")
segundos = 0.6

[sub_resource type="Resource" id="R_111"]
script = ExtResource("4_x")
texto = "[REI;rei;100] Hmpf."

[sub_resource type="Resource" id="R_112"]
script = ExtResource("2_x")
segundos = 0.3

[sub_resource type="Resource" id="R_113"]
script = ExtResource("4_x")
texto = "[REI;rei;100] ...Parece que funcionou."

[sub_resource type="Resource" id="R_114"]
script = ExtResource("2_x")
segundos = 0.3

[sub_resource type="Resource" id="R_115"]
script = ExtResource("4_x")
texto = "[REI;rei;100] Mas não pense que isso faz de você alguém de confiança, bruxa. Uma poção não muda o que..."

[sub_resource type="Resource" id="R_116"]
script = ExtResource("2_x")
segundos = 0.3

[sub_resource type="Resource" id="R_117"]
script = ExtResource("4_x")
texto = "[PRINCESA;princesa;100] Pai! Ela me ajudou."

[sub_resource type="Resource" id="R_118"]
script = ExtResource("2_x")
segundos = 0.4

[sub_resource type="Resource" id="R_119"]
script = ExtResource("4_x")
texto = "[PRINCESA;princesa;100] Obrigada, senhora bruxa. Agora consigo até pensar no vestido... o azul, talvez. Ou o branco com as fitas..."

[sub_resource type="Resource" id="R_120"]
script = ExtResource("2_x")
segundos = 0.3

[sub_resource type="Resource" id="R_121"]
script = ExtResource("4_x")
texto = "[PRINCESA;princesa;100] A senhora precisa vir ao casamento! Não é, pai?"

[sub_resource type="Resource" id="R_122"]
script = ExtResource("2_x")
segundos = 0.6

[sub_resource type="Resource" id="R_123"]
script = ExtResource("4_x")
