[sub_resource type="Resource" id="R_135"]
script = ExtResource("2_x")
segundos = 0.3

[sub_resource type="Resource" id="R_136"]
script = ExtResource("4_x")
texto = "[BRUXA;bruxa_grande;0] Ela está calma, Majestade. Como pediram."

