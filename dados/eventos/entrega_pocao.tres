[sub_resource type="Resource" id="R_117"]
script = ExtResource("4_x")
personagem = ExtResource("x2")
posicao = 100.0
texto = "Pai! Ela me ajudou."

[sub_resource type="Resource" id="R_118"]
script = ExtResource("2_x")
segundos = 0.4

[sub_resource type="Resource" id="R_119"]
script = ExtResource("4_x")
personagem = ExtResource("x2")
posicao = 100.0
texto = "Obrigada, senhora bruxa. Agora consigo até pensar no vestido... o azul, talvez. Ou o branco com as fitas..."

[sub_resource type="Resource" id="R_120"]
script = ExtResource("2_x")
segundos = 0.3

[sub_resource type="Resource" id="R_121"]
script = ExtResource("4_x")
personagem = ExtResource("x2")
posicao = 100.0
texto = "A senhora precisa vir ao casamento! Não é, pai?"

