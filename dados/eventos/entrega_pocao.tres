[sub_resource type="Resource" id="R_115"]
script = ExtResource("4_x")
personagem = ExtResource("x1")
posicao = 100.0
texto = "Mas não pense que isso faz de você alguém de confiança, bruxa. Uma poção não muda o que..."

[sub_resource type="Resource" id="R_116"]
