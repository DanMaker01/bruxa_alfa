script = ExtResource("2_x")
segundos = 0.3

[sub_resource type="Resource" id="R_125"]
script = ExtResource("4_x")
texto = "[REI;rei;100] Hmpf. Está bem. Está convidada, bruxa."

[sub_resource type="Resource" id="R_126"]
script = ExtResource("2_x")
segundos = 0.3

[sub_resource type="Resource" id="R_127"]
