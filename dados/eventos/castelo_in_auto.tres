segundos = 0.3

[sub_resource type="Resource" id="R_22"]
script = ExtResource("4_x")
texto = "[BRUXA;bruxa_grande;0] A lua ainda não está cheia. A poção precisa de mais uma noite."

[sub_resource type="Resource" id="R_23"]
script = ExtResource("4_x")
texto = "[REI;rei;100] Desculpas. Volte quando tiver algo que preste."

[sub_resource type="Resource" id="R_24"]
