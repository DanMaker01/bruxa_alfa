[sub_resource type="Resource" id="R_5"]
script = ExtResource("4_x")
texto = "[REI;rei;100] Então é você a tal bruxa de quem o camponês falou."

[sub_resource type="Resource" id="R_6"]
script = ExtResource("4_x")
texto = "[REI;rei;100] Não gosto de gente que mexe com ervas e conversa com os mortos."

[sub_resource type="Resource" id="R_7"]
script = ExtResource("4_x")
texto = "[REI;rei;100] Mas minha filha não dorme há dias."

[sub_resource type="Resource" id="R_8"]
script = ExtResource("2_x")
segundos = 0.5

[sub_resource type="Resource" id="R_9"]
script = ExtResource("4_x")
texto = "[PRINCESA;princesa;100] Pai... o casamento é daqui a três dias. Eu não consigo parar de tremer."

[sub_resource type="Resource" id="R_10"]
script = ExtResource("2_x")
segundos = 0.5

[sub_resource type="Resource" id="R_11"]
script = ExtResource("5_x")
pergunta = "[REI;rei;100] Diga logo, bruxa: essa sua poção vai funcionar?"
opcoes = Array[String](["Vai funcionar, Majestade.", "Acredito que sim...", "Não... ainda não."])
labels = Array[String](["sim", "talvez", "nao"])

[sub_resource type="Resource" id="R_12"]
script = ExtResource("6_x")
