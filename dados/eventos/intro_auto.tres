[sub_resource type="Resource" id="Resource_leg0"]
script = ExtResource("13_leg")
texto = "Entre o mundo dos vivos e o dos mortos existe um véu.

Poucos o percebem, mas quem lida com magia enxerga através dele."
segundos = 7.999999999999744

[sub_resource type="Resource" id="Resource_leg1"]
script = ExtResource("13_leg")
texto = "Em 1484, o Papa deu aos inquisidores o poder de caçar bruxas.

Toda mulher que vivesse sozinha, falasse com os mortos ou entendesse de ervas passou a ser suspeita."
segundos = 7.999999999999744

[sub_resource type="Resource" id="Resource_leg2"]
script = ExtResource("13_leg")
texto = "A Bruxa precisava se esconder.

Mas vivos e mortos continuavam batendo à sua porta, pedindo poções e favores."
segundos = 7.999999999999744

[sub_resource type="Resource" id="Resource_leg3"]
script = ExtResource("13_leg")
texto = "Para quem tem bons olhos, atrás do castelo se vê o véu, fino como névoa.

Com um pedaço dele na porta de casa, ela poderia chegar a qualquer lugar sem que ninguém a visse."
segundos = 9.99999999999968

[sub_resource type="Resource" id="Resource_leg4"]
script = ExtResource("13_leg")
texto = "Em três dias, ela ergueu a casa na floresta.

Amanhã, ela iria buscar o véu."
segundos = 7.999999999999744

