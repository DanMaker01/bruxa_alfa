[sub_resource type="Resource" id="Resource_0twvi"]
script = ExtResource("9_knu6e")
personagem = ExtResource("x2")
face = "pensando"
texto = "Enfim... Oito ervas, no final da floresta, e quatro cogumelos, logo depois da cidade."

[sub_resource type="Resource" id="T_resumo2"]
script = ExtResource("9_knu6e")
personagem = ExtResource("x2")
face = "pensando"
texto = "Cozinhando isso, depois é só ir ao castelo, não deve ser difícil."

