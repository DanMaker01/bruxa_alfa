[sub_resource type="Resource" id="Resource_qchvi"]
script = ExtResource("5_0jff4")
segundos = 2.0

[sub_resource type="Resource" id="Resource_cmkkc"]
script = ExtResource("9_knu6e")
personagem = ExtResource("x3")
posicao = 100.0
texto = "Com licença..."

[sub_resource type="Resource" id="Resource_575dk"]
script = ExtResource("9_knu6e")
personagem = ExtResource("x3")
posicao = 100.0
texto = "É aqui que mora a Bruxa? Passei o dia todo andando, quase me perdi duas vezes."

[sub_resource type="Resource" id="Resource_xw4px"]
script = ExtResource("9_knu6e")
personagem = ExtResource("x3")
posicao = 100.0
texto = "Eu queria falar com você, porque minh..."

[sub_resource type="Resource" id="R_irma_brux_0"]
script = ExtResource("9_knu6e")
personagem = ExtResource("x3")
posicao = 100.0
texto = "...a princesa. A princesa vai se casar amanhã. Mas ela está muito sensível. Não quer sair do castelo."

[sub_resource type="Resource" id="R_irma_brux_1"]
script = ExtResource("9_knu6e")
personagem = ExtResource("x3")
posicao = 100.0
texto = "Eu trabalho no castelo. Cuido dos cavalos."

[sub_resource type="Resource" id="R_irma_brux_2"]
script = ExtResource("9_knu6e")
personagem = ExtResource("x2")
texto = "Certo. E o que ela tem?"

[sub_resource type="Resource" id="Resource_p1udm"]
script = ExtResource("9_knu6e")
personagem = ExtResource("x3")
posicao = 100.0
texto = "Ela fala que o coração dispara, as mãos tremem, ela não come, não dorme."

[sub_resource type="Resource" id="Resource_j0vgw"]
script = ExtResource("9_knu6e")
personagem = ExtResource("x3")
posicao = 100.0
texto = "Fica dizendo que vai estragar tudo, que o noivo vai desistir, que todo mundo vai rir dela."

[sub_resource type="Resource" id="Resource_unal2"]
script = ExtResource("9_knu6e")
personagem = ExtResource("x3")
posicao = 100.0
texto = "Já chamaram os curandeiros do castelo, mas ela não melhora."

[sub_resource type="Resource" id="T_cura2"]
script = ExtResource("9_knu6e")
personagem = ExtResource("x3")
posicao = 100.0
texto = "Talvez o casamento nem aconteça. Ninguém sabe mais o que fazer."

[sub_resource type="Resource" id="R_estilo_pensa"]
script = ExtResource("92_chamar")
evento = ExtResource("93_pensa_ini")

[sub_resource type="Resource" id="Resource_tqa1j"]
script = ExtResource("9_knu6e")
personagem = ExtResource("x2")
face = "pensando"
texto = "Hmm... Coração disparado. Mãos trêmulas. A cabeça só pensa no pior."

[sub_resource type="Resource" id="Resource_rxkpu"]
script = ExtResource("9_knu6e")
personagem = ExtResource("x2")
face = "pensando"
texto = "Parece que o corpo dela não sabe mais descansar. Está neurótica."

[sub_resource type="Resource" id="R_estilo_volta"]
script = ExtResource("92_chamar")
evento = ExtResource("94_pensa_fim")

[sub_resource type="Resource" id="Resource_y11e0"]
script = ExtResource("9_knu6e")
personagem = ExtResource("x2")
texto = "Eu acho que uma Poção da Calma Profunda deve resolver."

[sub_resource type="Resource" id="Resource_ut354"]
script = ExtResource("9_knu6e")
personagem = ExtResource("x3")
posicao = 100.0
texto = "Calma profunda?"

[sub_resource type="Resource" id="Resource_50d2e"]
script = ExtResource("9_knu6e")
personagem = ExtResource("x2")
texto = "O medo vai continuar ali. Mas ela vai conseguir agir apesar dele. Levantar da cama, vestir o vestido, atravessar a igreja."

[sub_resource type="Resource" id="Resource_fmhl5"]
script = ExtResource("9_knu6e")
personagem = ExtResource("x2")
texto = "Deixe eu me lembrar... "

[sub_resource type="Resource" id="B_receita2"]
script = ExtResource("9_knu6e")
personagem = ExtResource("x2")
texto = "São oito ervas, que nascem no final da floresta..."

[sub_resource type="Resource" id="Resource_6i5r4"]
script = ExtResource("9_knu6e")
personagem = ExtResource("x3")
posicao = 100.0
texto = "No fim da floresta? Eu tenho medo de ir lá, desde que o príncipe Zigmund sumiu..."

[sub_resource type="Resource" id="Resource_vtqx8"]
script = ExtResource("9_knu6e")
personagem = ExtResource("x2")
texto = "Entendo... Mas deixe-me lembrar a receita."

[sub_resource type="Resource" id="Resource_3682x"]
script = ExtResource("9_knu6e")
personagem = ExtResource("x2")
texto = "Oito ervas... ok... e quatro cogumelos, que crescem logo depois da cidade."

[sub_resource type="Resource" id="Resource_oixjs"]
script = ExtResource("9_knu6e")
personagem = ExtResource("x2")
texto = "Vá para casa. Amanhã, antes do casamento, ela vai estar mais tranquila."

[sub_resource type="Resource" id="Resource_u7qwp"]
script = ExtResource("9_knu6e")
personagem = ExtResource("x3")
posicao = 100.0
texto = "A senhora... vai mesmo me ajudar?"

[sub_resource type="Resource" id="Resource_v0jwt"]
script = ExtResource("9_knu6e")
personagem = ExtResource("x2")
texto = "Ajudar não! Tudo tem seu preço."

[sub_resource type="Resource" id="Resource_exejc"]
script = ExtResource("9_knu6e")
personagem = ExtResource("x2")
texto = "Não será barato, mas eu só cobro o preço justo. Nem a mais, nem a menos."

[sub_resource type="Resource" id="Resource_6o5nu"]
script = ExtResource("9_knu6e")
personagem = ExtResource("x3")
posicao = 100.0
texto = "Está bem. Obrigado. Obrigado mesmo."

[sub_resource type="Resource" id="F_aviso_guarda"]
script = ExtResource("9_knu6e")
personagem = ExtResource("x3")
posicao = 100.0
texto = "Ah! A princesa já avisou os guardas sobre você. Mas só vão te deixar passar se tiver a poção em mãos."

[sub_resource type="Resource" id="B_adeus"]
script = ExtResource("9_knu6e")
personagem = ExtResource("x3")
posicao = 100.0
texto = "Adeus, senhora bruxa!"

[sub_resource type="Resource" id="Resource_ramt2"]
script = ExtResource("5_0jff4")

