[sub_resource type="Resource" id="Resource_qchvi"]
script = ExtResource("5_0jff4")
segundos = 2.0

[sub_resource type="Resource" id="Resource_cmkkc"]
script = ExtResource("9_knu6e")
texto = "[CAMPONÊS;campones;100] Com licença..."

[sub_resource type="Resource" id="Resource_575dk"]
script = ExtResource("9_knu6e")
texto = "[CAMPONÊS;campones;100] É aqui que mora a Bruxa? Passei o dia todo andando, quase me perdi duas vezes."

[sub_resource type="Resource" id="Resource_xw4px"]
script = ExtResource("9_knu6e")
texto = "[CAMPONÊS;campones;100] Eu queria falar com você, porque minha irmã vai se casar amanhã. Mas ela não sai da cama."

[sub_resource type="Resource" id="Resource_p1udm"]
script = ExtResource("9_knu6e")
texto = "[CAMPONÊS;campones;100] Ela fala que o coração dispara, as mãos tremem, ela não come, não dorme."

[sub_resource type="Resource" id="Resource_j0vgw"]
script = ExtResource("9_knu6e")
texto = "[CAMPONÊS;campones;100] Fica dizendo que vai estragar tudo, que o noivo vai desistir, que todo mundo vai rir dela."

[sub_resource type="Resource" id="Resource_unal2"]
script = ExtResource("9_knu6e")
texto = "[CAMPONÊS;campones;100] Já chamei um médico, mas ela não melhora, e talvez o casamento não aconteça. Eu não sei mais o que fazer."

[sub_resource type="Resource" id="Resource_tqa1j"]
script = ExtResource("9_knu6e")
texto = "[BRUXA;bruxa_grande;0] (pensando) Coração disparado. Mãos trêmulas. Pensamentos catastróficos. "

[sub_resource type="Resource" id="Resource_rxkpu"]
script = ExtResource("9_knu6e")
texto = "[BRUXA;bruxa_grande;0] (pensando) Parece que o corpo dela não sabe mais descansar."

[sub_resource type="Resource" id="Resource_y11e0"]
script = ExtResource("9_knu6e")
texto = "[BRUXA;bruxa_grande;0] Eu acho que uma Poção da Calma Profunda deve resolver."

[sub_resource type="Resource" id="Resource_ut354"]
script = ExtResource("9_knu6e")
texto = "[CAMPONÊS;campones;100] Calma profunda?"

[sub_resource type="Resource" id="Resource_50d2e"]
script = ExtResource("9_knu6e")
texto = "[BRUXA;bruxa_grande;0] O medo vai continuar ali. Mas ela vai conseguir agir apesar dele. Levantar da cama, vestir o vestido, atravessar a igreja."

[sub_resource type="Resource" id="Resource_fmhl5"]
script = ExtResource("9_knu6e")
texto = "[BRUXA;bruxa_grande;0] Deixe eu me lembrar... são oito cogumelos, que crescem logo depois da cidade."

[sub_resource type="Resource" id="Resource_3682x"]
script = ExtResource("9_knu6e")
texto = "[BRUXA;bruxa_grande;0] E oito ervas, que posso pegar no final da floresta."

[sub_resource type="Resource" id="Resource_6i5r4"]
script = ExtResource("9_knu6e")
texto = "[CAMPONÊS;campones;100] No fim da floresta? Dá um medo de ir lá."

[sub_resource type="Resource" id="Resource_vtqx8"]
script = ExtResource("9_knu6e")
texto = "[BRUXA;bruxa_grande;0] Eu sei. Deixa essa parte comigo."

[sub_resource type="Resource" id="Resource_oixjs"]
script = ExtResource("9_knu6e")
texto = "[BRUXA;bruxa_grande;0] Vá para casa. Fique com sua irmã. Amanhã, antes do casamento, ela vai estar de pé."

[sub_resource type="Resource" id="Resource_u7qwp"]
script = ExtResource("9_knu6e")
texto = "[CAMPONÊS;campones;100] A senhora... vai mesmo me ajudar?"

[sub_resource type="Resource" id="Resource_v0jwt"]
script = ExtResource("9_knu6e")
texto = "[BRUXA;bruxa_grande;0] Ajudar não! Tudo tem seu preço."

[sub_resource type="Resource" id="Resource_exejc"]
script = ExtResource("9_knu6e")
texto = "[BRUXA;bruxa_grande;0] E não será barato."

[sub_resource type="Resource" id="Resource_6o5nu"]
script = ExtResource("9_knu6e")
texto = "[CAMPONÊS;campones;100] Tudo bem. Obrigado. Obrigado mesmo."

